ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-drive-api-key-here

# Optional — leave unset locally. Set on Streamlit Cloud before sharing the
# app's URL with anyone: gates the whole app behind this password. To rotate
# a key later (e.g. if one runs out of funds), edit it directly in Streamlit
# Cloud's "Manage app" -> Secrets — that requires GitHub write access on this
# repo, so only grant it to people you'd also trust with the code.
ACCESS_PASSWORD=choose-a-shared-password
