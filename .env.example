ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_API_KEY=your-google-drive-api-key-here

# Optional — leave unset locally. Set both on Streamlit Cloud before sharing
# the app's URL with anyone: ACCESS_PASSWORD gates the whole app; ADMIN_PASSWORD
# unlocks a sidebar panel to swap either key above at runtime (e.g. if one
# runs out of funds) without needing Streamlit Cloud or GitHub access.
ACCESS_PASSWORD=choose-a-shared-password
ADMIN_PASSWORD=choose-a-different-more-privileged-password
